class Solution {
    public int maxVowels(String s, int k) {
        int maxCnt = 0;

        int l =0;
        Set<Character> set = new HashSet<>();

        for(char ch:"aeiou".toCharArray()){
            set.add(ch);
        }
        
        // 21ms
        int cnt=0;
        for(int i=0;i<k;i++){
            if(set.contains(s.charAt(i))){
                cnt++;
            }
        }
        maxCnt =cnt;
        for(int r=k;r<s.length();r++){
            if(set.contains(s.charAt(r-k))){
                cnt--;
                l++;
            }
            if(set.contains(s.charAt(r))){
                cnt++;
            }

            

            if(cnt>maxCnt){
                maxCnt =cnt;
            }
        }

        return maxCnt;

